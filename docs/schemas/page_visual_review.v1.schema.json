{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "page_visual_review.v1",
  "type": "object",
  "required": ["schema_version", "reviewed_pdf_sha256", "expected_pages",
                "reviewed_pages", "page_records", "verdict"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2},
    "reviewed_pdf_sha256": {"type": "string", "minLength": 64},
    "expected_pages": {"type": "integer", "minimum": 1},
    "reviewed_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "coverage_complete": {"type": ["boolean", "null"]},
    "page_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "verdict"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "asset_sha256": {"type": ["string", "null"]},
          "verdict": {"type": "string"},
          "checks": {"type": "array", "items": {"type": "string"}},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "page_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "type", "severity"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "type": {"type": "string"},
          "severity": {"type": "string", "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "OK"]},
          "resolution": {"type": ["object", "string", "null"]}
        }
      }
    },
    "trips": {"type": "array", "items": {"type": "object"}},
    "verdict": {"type": ["string", "object"]}
  }
}
