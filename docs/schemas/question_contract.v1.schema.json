{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "question_contract.v1",
  "type": "object",
  "required": ["schema_version", "questions"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "original_request", "decision_target", "analysis_unit",
                      "observation_unit", "required_outputs"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "original_request": {"type": "string"},
          "decision_target": {"type": "string"},
          "analysis_unit": {"type": "string"},
          "observation_unit": {"type": "string"},
          "special_data_structure": {"type": ["string", "object", "array", "null"]},
          "required_outputs": {"type": "array", "items": {"type": "string"}},
          "allowed_information": {"type": ["array", "string", "null"]},
          "forbidden_information": {"type": ["array", "string", "null"]},
          "evaluation_target": {"type": ["array", "string", "null"],
                                "items": {"type": "string"}}
        }
      }
    }
  }
}
