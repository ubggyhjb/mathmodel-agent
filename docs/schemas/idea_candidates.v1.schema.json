{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "idea_candidates.v1",
  "type": "object",
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["idea_id", "question_id", "method_family", "core_hypothesis",
                      "required_assumptions", "failure_conditions"],
        "properties": {
          "idea_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "method_family": {"type": "string"},
          "tier": {"type": "string",
                   "enum": ["minimal_sufficient_solution", "recommended_solution",
                            "advanced_alternative"]},
          "core_hypothesis": {"type": "string"},
          "required_variables": {"type": "array", "items": {"type": "string"}},
          "required_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["candidate", "rejected", "accepted"]}
        }
      }
    }
  }
}
